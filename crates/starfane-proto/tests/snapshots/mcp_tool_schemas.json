          "description": "Optional explicit caller session id; overrides the cached identity.",
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "playbook": {
          "enum": [
            "feature",
            "debug"
          ],
          "type": "string"
        },
        "project_root": {
          "type": "string"
        },
        "utterance": {
          "type": "string"
        }
      },
      "required": [
        "goal"
      ],
      "type": "object"
    },
    "name": "start_pipeline"
