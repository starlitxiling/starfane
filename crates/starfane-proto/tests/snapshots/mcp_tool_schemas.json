[
  {
    "description": "List agent sessions known to starfane (agent, pane, state, model, pipeline stage).",
    "inputSchema": {
      "properties": {
        "include_subagents": {
          "type": "boolean"
        },
        "project": {
          "description": "Git root path or project name filter.",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "name": "list_sessions"
  },
  {
    "description": "Hand work or context to another agent session. The body is stored by starfane; the target only receives a one-line pointer. Builders finish the implement stage with intent=review and a self_test.",
    "inputSchema": {
      "properties": {
        "body_md": {
          "type": "string"
        },
        "from_session": {
          "description": "Optional explicit caller session id; overrides the cached identity.",
          "type": "string"
        },
        "intent": {
          "enum": [
            "review",
            "implement",
            "continue",
            "ask",
            "fyi"
          ],
          "type": "string"
        },
        "mode": {
          "enum": [
            "read_only",
            "write"
          ],
          "type": "string"
        },
        "refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "self_test": {
          "properties": {
            "cmd": {
              "type": "string"
            },
            "outcome": {
              "enum": [
                "pass",
                "fail",
                "not_run"
              ],
              "type": "string"
            },
            "output_tail": {
              "description": "Last ≤2000 chars of output.",
              "type": "string"
            }
          },
          "required": [
            "cmd",
            "outcome"
          ],
          "type": "object"
        },
        "summary": {
          "maxLength": 500,
          "type": "string"
        },
        "to": {
          "properties": {
            "agent": {
              "enum": [
                "claude",
                "codex",
                "agy"
              ],
              "type": "string"
            },
            "pane": {
              "description": "tmux pane id, e.g. %12",
              "type": "string"
            },
            "session_id": {
              "type": "string"
            },
            "stage": {
              "properties": {
                "pipeline_id": {
                  "type": "string"
                },
                "stage": {
                  "enum": [
                    "plan",
                    "implement",
                    "test_review",
                    "report",
                    "triage",
                    "deep"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "pipeline_id",
                "stage"
              ],
              "type": "object"
            }
          },
          "type": "object"
        },
        "todo": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "to",
        "intent",
        "mode",
        "summary",
        "body_md"
      ],
      "type": "object"
    },
    "name": "create_handoff"
  },
  {
    "description": "Fetch tasks, handoffs, messages and review requests addressed to this session.",
    "inputSchema": {
      "properties": {
        "from_session": {
          "description": "Optional explicit caller session id; overrides the cached identity.",
          "type": "string"
        },
        "mark_delivered": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [],
      "type": "object"
    },
    "name": "read_inbox"
  },
  {
    "description": "Acknowledge a handoff (acked = started, done = finished).",
    "inputSchema": {
      "properties": {
        "from_session": {
          "description": "Optional explicit caller session id; overrides the cached identity.",
          "type": "string"
        },
        "handoff_id": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "status": {
          "enum": [
            "acked",
            "done"
          ],
          "type": "string"
        }
      },
      "required": [
        "handoff_id",
        "status"
      ],
      "type": "object"
    },
    "name": "ack_handoff"
  },
  {
    "description": "Submit a review.v1 report. Every finding needs verbatim evidence; quotes are mechanically verified against the head commit and fabricated ones are rejected.",
    "inputSchema": {
      "properties": {
        "from_session": {
          "description": "Optional explicit caller session id; overrides the cached identity.",
          "type": "string"
        },
        "review": {
          "description": "review.v1 (header may be omitted). Zero findings with checked_areas is a valid, encouraged result.",
          "properties": {
            "base": {
              "description": "Base commit of the reviewed range.",
              "type": "string"
            },
            "checked_areas": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "depth": {
              "enum": [
                "D0",
                "D1",
                "D2",
                "D3"
              ],
              "type": "string"
            },
            "findings": {
              "items": {
                "properties": {
                  "category": {
                    "enum": [
                      "correctness",
                      "concurrency",
                      "security",
                      "perf",
                      "api",
                      "style"
                    ],
                    "type": "string"
                  },
                  "checked_guards": {
                    "items": {
                      "properties": {
                        "file": {
                          "type": "string"
                        },
                        "line": {
                          "minimum": 1,
                          "type": "integer"
                        },
                        "note": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "file",
                        "line"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "claim": {
                    "description": "One falsifiable sentence.",
                    "type": "string"
                  },
                  "confidence": {
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "type": "number"
                  },
                  "evidence": {
                    "items": {
                      "properties": {
                        "file": {
                          "type": "string"
                        },
                        "line_end": {
                          "minimum": 1,
                          "type": "integer"
                        },
                        "line_start": {
                          "minimum": 1,
                          "type": "integer"
                        },
                        "quote": {
                          "description": "Verbatim lines copied from the file at the reviewed commit.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "file",
                        "line_start",
                        "line_end",
                        "quote"
                      ],
                      "type": "object"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "id": {
                    "description": "Leave empty; assigned by starfane.",
                    "type": "string"
                  },
                  "location": {
                    "properties": {
                      "file": {
                        "type": "string"
                      },
                      "line_end": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "line_start": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "symbol": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "file",
                      "line_start",
                      "line_end"
                    ],
                    "type": "object"
                  },
                  "observable_impact": {
                    "type": "string"
                  },
                  "preconditions": {
                    "type": "string"
                  },
                  "repro": {
                    "properties": {
                      "content": {
                        "type": "string"
                      },
                      "kind": {
                        "enum": [
                          "test",
                          "input",
                          "none"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "type": "object"
                  },
                  "severity": {
                    "enum": [
                      "blocker",
                      "major",
                      "minor",
                      "nit"
                    ],
                    "type": "string"
                  },
                  "suggested_fix": {
                    "type": "string"
                  },
                  "trigger_path": {
                    "items": {
                      "properties": {
                        "file": {
                          "type": "string"
                        },
                        "line": {
                          "minimum": 1,
                          "type": "integer"
                        },
                        "note": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "file",
                        "line"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "verification_method": {
                    "enum": [
                      "code_trace",
                      "static_check",
                      "repro_test"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "category",
                  "severity",
                  "confidence",
                  "claim",
                  "location",
                  "evidence",
                  "verification_method"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "head": {
              "description": "Reviewed commit; evidence is verified against this tree.",
              "type": "string"
            },
            "scope_files": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "summary": {
              "type": "string"
            }
          },
          "required": [
            "depth",
            "base",
            "head"
          ],
          "type": "object"
        }
      },
      "required": [
        "review"
      ],
      "type": "object"
    },
    "name": "submit_review"
  },
  {
    "description": "As falsifier, record your attempt to disprove a finding. 'disproved' requires verbatim counter_evidence; without it the verdict becomes needs_human.",
    "inputSchema": {
      "properties": {
        "counter_evidence": {
          "items": {
            "properties": {
              "file": {
                "type": "string"
              },
              "line_end": {
                "minimum": 1,
                "type": "integer"
              },
              "line_start": {
                "minimum": 1,
                "type": "integer"
              },
              "quote": {
                "description": "Verbatim lines copied from the file at the reviewed commit.",
                "type": "string"
              }
            },
            "required": [
              "file",
              "line_start",
              "line_end",
              "quote"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "finding_id": {
          "type": "string"
        },
        "from_session": {
          "description": "Optional explicit caller session id; overrides the cached identity.",
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "review_id": {
          "type": "string"
        },
        "to": {
          "enum": [
            "blocker",
            "major",
            "minor",
            "nit"
          ],
          "type": "string"
        },
        "verdict": {
          "enum": [
            "confirmed",
            "needs_human",
            "downgraded",
            "disproved"
          ],
          "type": "string"
        }
      },
      "required": [
        "review_id",
        "finding_id",
        "verdict",
        "rationale"
      ],
      "type": "object"
    },
    "name": "submit_falsifier_verdict"
  },
  {
    "description": "Submit Phase A fast-triage results (triage.v1): at most 2 evidence-backed hypotheses plus mitigation.",
    "inputSchema": {
      "properties": {
        "from_session": {
          "description": "Optional explicit caller session id; overrides the cached identity.",
          "type": "string"
        },
        "triage": {
          "description": "triage.v1 (header may be omitted). Every conclusion is a hypothesis, never a confirmed root cause.",
          "properties": {
            "elapsed_secs": {
              "minimum": 0,
              "type": "integer"
            },
            "hypotheses": {
              "items": {
                "properties": {
                  "claim": {
                    "type": "string"
                  },
                  "confidence": {
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "type": "number"
                  },
                  "evidence_refs": {
                    "items": {
                      "oneOf": [
                        {
                          "properties": {
                            "file": {
                              "type": "string"
                            },
                            "line_end": {
                              "minimum": 1,
                              "type": "integer"
                            },
                            "line_start": {
                              "minimum": 1,
                              "type": "integer"
                            },
                            "quote": {
                              "type": "string"
                            },
                            "type": {
                              "const": "code"
                            }
                          },
                          "required": [
                            "type",
                            "file",
                            "line_start",
                            "line_end",
                            "quote"
                          ],
                          "type": "object"
                        },
                        {
                          "properties": {
                            "line": {
                              "minimum": 1,
                              "type": "integer"
                            },
                            "path": {
                              "description": "Log file path, relative to repo root or absolute.",
                              "type": "string"
                            },
                            "quote": {
                              "description": "Verbatim log text.",
                              "type": "string"
                            },
                            "type": {
                              "const": "log"
                            }
                          },
                          "required": [
                            "type",
                            "path",
                            "quote"
                          ],
                          "type": "object"
                        }
                      ]
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "how_to_confirm": {
                    "type": "string"
                  },
                  "kind": {
                    "const": "hypothesis"
                  }
                },
                "required": [
                  "claim",
                  "confidence",
                  "evidence_refs",
                  "how_to_confirm"
                ],
                "type": "object"
              },
              "maxItems": 2,
              "minItems": 1,
              "type": "array"
            },
            "mitigation": {
              "type": "string"
            },
            "probes": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "symptom": {
              "type": "string"
            }
          },
          "required": [
            "symptom",
            "hypotheses"
          ],
          "type": "object"
        }
      },
      "required": [
        "triage"
      ],
      "type": "object"
    },
    "name": "submit_triage"
  },
